MCP_EMAIL_ENV=development
MCP_EMAIL_LOG_LEVEL=INFO
MCP_EMAIL_POLL_BATCH_SIZE=25
# Required for every MCP request, including initialize. Mandatory at production startup.
MCP_EMAIL_ACCESS_TOKEN=replace-me
# Polling is disabled unless this separate secret is configured.
MCP_EMAIL_POLL_WEBHOOK_SECRET=replace-me

# Optional server-to-server quotation API (configure both to enable).
# Generate a distinct token with secrets.token_urlsafe(32); never place it in a URL.
# MCP_EMAIL_QUOTER_TOKEN=replace-me
# MCP_EMAIL_QUOTER_ACCOUNT=sales
MCP_EMAIL_QUOTATION_MAX_REQUEST_BYTES=16777216
MCP_EMAIL_QUOTATION_MAX_FILE_BYTES=10485760
MCP_EMAIL_QUOTATION_MAX_TOTAL_BYTES=10485760
MCP_EMAIL_QUOTATION_MAX_ATTACHMENTS=1
MCP_EMAIL_QUOTATION_MAX_RECIPIENTS=20
MCP_EMAIL_QUOTATION_CONCURRENCY=2
MCP_EMAIL_QUOTATION_PER_MINUTE=10
MCP_EMAIL_QUOTATION_RETENTION_DAYS=90
MCP_EMAIL_SMTP_TIMEOUT_SECONDS=30
MCP_EMAIL_QUOTATION_TIMEOUT_SECONDS=120
MCP_EMAIL_QUOTATION_UPLOAD_TIMEOUT_SECONDS=30

# Optional multi-account configuration. When provided, each account can override
# the shared IMAP/SMTP defaults below. The account_name becomes the default
# mailbox_id if mailbox_id is omitted.
# MCP_EMAIL_ACCOUNTS_JSON=[{"account_name":"sales","mailbox_id":"sales","imap_username":"sales@example.com","imap_password":"replace-me","smtp_username":"sales@example.com","smtp_password":"replace-me","smtp_from_address":"sales@example.com"},{"account_name":"support","mailbox_id":"support","imap_username":"support@example.com","imap_password":"replace-me","smtp_username":"support@example.com","smtp_password":"replace-me","smtp_from_address":"support@example.com","imap_mailbox":"Support"}]

MCP_EMAIL_IMAP_HOST=mail.example.com
MCP_EMAIL_IMAP_PORT=993
MCP_EMAIL_IMAP_USERNAME=agent@example.com
MCP_EMAIL_IMAP_PASSWORD=replace-me
MCP_EMAIL_IMAP_MAILBOX=INBOX
MCP_EMAIL_MAILBOX_ID=agent

MCP_EMAIL_SMTP_HOST=mail.example.com
MCP_EMAIL_SMTP_PORT=587
MCP_EMAIL_SMTP_USERNAME=agent@example.com
MCP_EMAIL_SMTP_PASSWORD=replace-me
MCP_EMAIL_SMTP_FROM_ADDRESS=agent@example.com
MCP_EMAIL_SMTP_USE_TLS=false
MCP_EMAIL_SMTP_STARTTLS=true

MCP_EMAIL_OPENROUTER_API_KEY=replace-me
MCP_EMAIL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MCP_EMAIL_OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

MCP_EMAIL_SUPABASE_URL=https://your-project-ref.supabase.co
MCP_EMAIL_SUPABASE_SERVICE_ROLE_KEY=replace-me
MCP_EMAIL_SUPABASE_SCHEMA=public
MCP_EMAIL_SUPABASE_MESSAGES_TABLE=email_embeddings
MCP_EMAIL_SUPABASE_SYNC_STATE_TABLE=email_ingest_state
MCP_EMAIL_SUPABASE_ATTACHMENTS_TABLE=email_attachments
MCP_EMAIL_SUPABASE_ATTACHMENT_POLICY_TABLE=attachment_sender_policy

# Inbound attachments pipeline (fail-closed; see docs/attachments.md).
# The authserv-id expected in the topmost Authentication-Results header;
# defaults to MCP_EMAIL_IMAP_HOST when unset.
# MCP_EMAIL_IMAP_AUTHSERV_ID=mail.example.com
MCP_EMAIL_ATTACHMENT_MAX_COUNT=10
MCP_EMAIL_ATTACHMENT_MAX_FILE_BYTES=10485760
MCP_EMAIL_ATTACHMENT_MAX_MESSAGE_BYTES=26214400
MCP_EMAIL_ATTACHMENT_RETENTION_DAYS=20
MCP_EMAIL_ATTACHMENT_STORAGE_BUCKET=email-attachments
MCP_EMAIL_ATTACHMENT_SIGNED_URL_TTL_SECONDS=300
MCP_EMAIL_ATTACHMENT_POLICY_CACHE_SECONDS=300
MCP_EMAIL_ATTACHMENT_EXTRACT_MAX_CHARS=6000
MCP_EMAIL_ATTACHMENT_EXTRACT_TIMEOUT_SECONDS=30
# Auto-archive allowlisted senders' attachments during sync (off by default).
MCP_EMAIL_ATTACHMENT_AUTO_ARCHIVE=false
MCP_EMAIL_ATTACHMENT_AUTO_ARCHIVE_MAX_BYTES=52428800

# Standalone ClamAV scanner. Cloud Run uses IAM/OIDC; set the shared token only
# for development or non-GCP scanner deployments.
MCP_EMAIL_CLAMAV_URL=https://clamav-scanner-example.a.run.app
# MCP_EMAIL_CLAMAV_AUTH_TOKEN=replace-me
MCP_EMAIL_CLAMAV_TIMEOUT_SECONDS=60
